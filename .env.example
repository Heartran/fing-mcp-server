# Optional: explicit Fing local API auth token.
# On PC-FEDERICO this is auto-discovered from:
# %APPDATA%\FingAgent\conf\localapi\fingagent.json
FING_LOCALAPI_AUTH=

# Backward-compatible alias for the same auth token.
FING_API_KEY=

# Optional: override the Fing local API port.
FING_LOCALAPI_PORT=49090

# Optional: override the Fing local API base URL.
# Do not add the old /1 suffix.
FING_BASE_URL=http://localhost:49090

# Optional: override the local Fing config file path.
FING_LOCALAPI_CONFIG=

# Optional: port used by this MCP server.
PORT=3010
